# 한국투자증권 KIS 실전 Open API. 값은 절대 Git에 커밋하지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 선택: KRX 공식 Open API를 사용한다면 입력합니다.
KRX_OPEN_API_KEY=

# Cloudflare Worker의 /api/sync 보호용 비밀값
DASHBOARD_SYNC_TOKEN=

# 배포 주소 (예: https://hanyabyab1212-ai.github.io/stockbot-domestic-dashboard)
PUBLIC_DASHBOARD_URL=

# Worker URL (예: https://stockbot-domestic-api.hanyabyab1212.workers.dev)
DASHBOARD_API_URL=

# 첫 실행에서 이전 거래일을 채울 개수. 0이면 가장 최근 거래일만 수집합니다.
BACKFILL_DAYS=0
